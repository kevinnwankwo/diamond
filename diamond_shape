# Top half of the diamond
for i in range(1, 8 + 1):
    # Print leading spaces for alignment, then the odd number of stars
    print(" " * (8 - i) + "*" * (2 * i - 1))

# Bottom half of the diamond
for i in range(7, 0, -1):
    # Print leading spaces for alignment, then the odd number of stars
    print(" " * (8 - i) + "*" * (2 * i - 1))
